---
interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  homeHref?: string;
  links?: FooterLink[];
  copyright?: string;
}

const {
  homeHref = '/',
  links = [],
  copyright = '© Smart ホームシアター',
} = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <a href={homeHref} class="brand" aria-label="Smart ホームシアター ホーム">
        <img class="brand-mark" src="/images/brand/logo.png" alt="Smart Home Theater ロゴ" width="44" height="44" />
      </a>
      {links.length > 0 && (
        <ul class="footer-nav">
          {links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      )}
    </div>
    <div class="copyright">{copyright}</div>
  </div>
</footer>
