---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  homeHref?: string;
  navLinks?: NavLink[];
}

const {
  homeHref = '/',
  navLinks = [],
} = Astro.props;
---

<header class="site-header">
  <div class="container">
    <a href={homeHref} class="brand" aria-label="Smart ホームシアター ホーム">
      <img class="brand-mark" src="/images/brand/logo.png" alt="Smart Home Theater ロゴ" width="44" height="44" />
    </a>
    <nav class="nav" aria-label="メインナビ">
      {navLinks.length > 0 && (
        <ul class="nav-links">
          {navLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      )}
    </nav>
  </div>
</header>
