---
import "../styles/global.css";

// astro.config.mjs の site が唯一のドメイン定義（末尾スラッシュ付きで解決される）
const site = Astro.site.href;
const ogImage = new URL("images/brand/og.jpg", site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Smart ホームシアター",
  url: site,
  logo: new URL("images/brand/logo.webp", site).href,
  sameAs: ["https://www.instagram.com/smart.hometheater/"],
  subOrganization: [
    {
      "@type": "LocalBusiness",
      name: "Smart ホームシアター 横浜中華街",
      url: `${site}#yokohama`,
      priceRange: "¥577〜",
      address: {
        "@type": "PostalAddress",
        streetAddress: "石川町1丁目",
        addressLocality: "横浜市中区",
        addressRegion: "神奈川県",
        postalCode: "231-0868",
        addressCountry: "JP",
      },
    },
    {
      "@type": "LocalBusiness",
      name: "Smart ホームシアター 大船",
      url: `${site}#ofuna`,
      priceRange: "¥1,200〜",
      address: {
        "@type": "PostalAddress",
        streetAddress: "大船1丁目13-7 ステラビル5階",
        addressLocality: "鎌倉市",
        addressRegion: "神奈川県",
        postalCode: "247-0056",
        addressCountry: "JP",
      },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="ja">

<head>
  <link as="image" fetchpriority="high" href="/images/figma/hero-bg.webp" rel="preload" type="image/webp" />
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta content="#0E0E12" name="theme-color" />
  <title>横浜中華街・大船の貸切シアター＆レンタルスペース｜Smartホームシアター</title>
  <link rel="icon" href="/images/brand/logo.svg" type="image/svg+xml">
  <meta content="横浜中華街店（石川町駅 徒歩4分）と大船店（大船駅 徒歩4分）の2拠点。映画館のような設備と、リビングのようなくつろぎで、映画鑑賞・推し活・誕生日会・ゲーム大会・スポーツ観戦に。"
    name="description" />
  <meta name="robots" content="index,follow"> 
  <link href={site} rel="canonical" />
  <meta content="website" property="og:type" />
  <meta content="Smart ホームシアター｜友達と過ごす特別な時間を。" property="og:title" />
  <meta content="横浜中華街・大船の2拠点。映画も、推し活も、パーティーも。大画面×本格音響の貸切シアター。" property="og:description" />
  <meta content={ogImage} property="og:image" />
  <meta content={site} property="og:url" />
  <meta content="Smart ホームシアター" property="og:site_name" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
</head>

<body class="">
  <slot />
  <script>
    import "../scripts/main.js";
  </script>
</body>

</html>
