              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" aria-hidden="true">
                <rect x="3" y="4" width="18" height="17" rx="2" />
                <path d="M3 9h18M8 2v4M16 2v4" />
              </svg>
              <span class="label"><small>横浜中華街店の</small><strong>空き状況を確認する</strong></span>
            </a>
            <a href={SPACEMARKET_OFUNA} target="_blank" rel="noopener noreferrer" class="availability-btn" data-location="ofuna">
