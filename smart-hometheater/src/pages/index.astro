---
import BaseLayout from "../layouts/BaseLayout.astro";
import LineButton from "../components/LineButton.astro";

const navLinks = [
  { label: "使用用途", href: "#scenes" },
  { label: "横浜中華街店", href: "#yokohama" },
  { label: "大船店", href: "#ofuna" },
  { label: "利用の流れ", href: "#flow" },
  { label: "お客様の声", href: "#voices" },
  { label: "よくある質問", href: "#faq" },
  { label: "アクセス", href: "#access" },
  { label: "予約・お問い合わせ", href: "#booking" },
];

const SPACEMARKET_YOKOHAMA = "https://www.spacemarket.com/spaces/theater-motomachi/";
const SPACEMARKET_OFUNA = "https://www.spacemarket.com/spaces/theater-ofuna/";
const INSTAGRAM_URL = "https://www.instagram.com/smart.hometheater/";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Smart ホームシアター",
  url: "https://example.com/",
  logo: "https://example.com/images/brand/logo.png",
  sameAs: [INSTAGRAM_URL],
  subOrganization: [
    {
      "@type": "LocalBusiness",
      name: "Smart ホームシアター 横浜中華街",
      url: "https://example.com/#yokohama",
      priceRange: "¥577〜",
      address: {
        "@type": "PostalAddress",
        streetAddress: "石川町1丁目",
        addressLocality: "横浜市中区",
        addressRegion: "神奈川県",
        postalCode: "231-0868",
        addressCountry: "JP",
      },
    },
    {
      "@type": "LocalBusiness",
      name: "Smart ホームシアター 大船",
      url: "https://example.com/#ofuna",
      priceRange: "¥1,200〜",
      address: {
        "@type": "PostalAddress",
        streetAddress: "大船1丁目13-7 ステラビル5階",
        addressLocality: "鎌倉市",
        addressRegion: "神奈川県",
        postalCode: "247-0056",
        addressCountry: "JP",
      },
    },
  ],
};

const heroBg =
  "linear-gradient(135deg, rgba(14,14,18,0.25), rgba(14,14,18,0.55)), url('/images/figma/hero-bg.jpg')";

const motomachiBg =
  "linear-gradient(180deg, rgba(14,14,18,0.2), rgba(14,14,18,0.6)), url('/images/brand/motomachi.jpg')";
const ofunaBg =
  "linear-gradient(180deg, rgba(14,14,18,0.2), rgba(14,14,18,0.6)), url('/images/brand/ofuna.png')";

const personaCards = [
  { image: "/images/figma/persona-movie.jpg", jp: "映画鑑賞", en: "Watch movie" },
  { image: "/images/figma/persona-oshikatsu.jpg", jp: "推し活・ライブ鑑賞", en: "OSHI KATSU" },
  { image: "/images/figma/persona-games.jpg", jp: "ゲーム大会", en: "Play games" },
  { image: "/images/figma/persona-girlsparty.jpg", jp: "女子会・パーティ", en: "Girls party" },
];

// 横浜中華街店
const yokohamaHeroImg = "url('/images/brand/motomachi.jpg')";

const yokohamaEquipment = [
  { label: "プロジェクター", brand: "XGIMI", img: "/images/figma/eq-yokohama-xgimi.png" },
  { label: "アンプ", brand: "DENON", img: "/images/figma/eq-yokohama-denon.png" },
  { label: "音響", brand: "POLK AUDIO Monitor XTシリーズ", img: "/images/figma/eq-yokohama-polk-1.png" },
  { label: "再生機器", brand: "Blu-rayプレイヤー", img: "/images/figma/eq-yokohama-bluray.png" },
  { label: "ゲーム機器", brand: "Nintendo Switch", img: "/images/figma/eq-switch.png" },
];

const yokohamaGallery = [
  { full: "https://images.unsplash.com/photo-1574375927938-d5a98e8ffe85?auto=format&fit=crop&w=1600&q=80", thumb: "https://images.unsplash.com/photo-1574375927938-d5a98e8ffe85?auto=format&fit=crop&w=900&q=80", alt: "シアタールーム全景（差し替え予定）" },
  { full: "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1600&q=80", thumb: "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=600&q=80", alt: "スクリーン投影の様子（差し替え予定）" },
  { full: "https://images.unsplash.com/photo-1574267432553-4b4628081c31?auto=format&fit=crop&w=1600&q=80", thumb: "https://images.unsplash.com/photo-1574267432553-4b4628081c31?auto=format&fit=crop&w=600&q=80", alt: "キッチンエリア（差し替え予定）" },
  { full: "https://images.unsplash.com/photo-1542204165-65bf26472b9b?auto=format&fit=crop&w=1600&q=80", thumb: "https://images.unsplash.com/photo-1542204165-65bf26472b9b?auto=format&fit=crop&w=600&q=80", alt: "サウンドシステム（差し替え予定）" },
  { full: "https://images.unsplash.com/photo-1585951237318-9ea5e175b891?auto=format&fit=crop&w=1600&q=80", thumb: "https://images.unsplash.com/photo-1585951237318-9ea5e175b891?auto=format&fit=crop&w=600&q=80", alt: "ゲーム機・周辺機器（差し替え予定）" },
];

const yokohamaReviews = [
  "/images/figma/review-yokohama-1.png",
  "/images/figma/review-yokohama-2.png",
  "/images/figma/review-yokohama-3.png",
  "/images/figma/review-yokohama-4.png",
];

// 大船店
const ofunaHeroImg = "url('/images/ofuna/hero/ofuna.png')";

const ofunaEquipment = [
  { label: "プロジェクター", brand: "XGIMI", img: "/images/figma/eq-ofuna-xgimi.png" },
  { label: "アンプ", brand: "DENON", img: "/images/figma/eq-ofuna-denon.png" },
  { label: "音響", brand: "POLK AUDIO Monitor XTシリーズ", img: "/images/figma/eq-ofuna-polk.png" },
  { label: "再生機器", brand: "Blu-rayプレイヤー LG UBK80S", img: "/images/figma/eq-ofuna-bluray.png" },
  { label: "ゲーム機器", brand: "Nintendo Switch", img: "/images/figma/eq-switch.png" },
];

const ofunaGalleryFiles = [
  "DSC_0406.jpg", "DSC_0409.jpg", "DSC_0418.jpg", "DSC_0426.jpg", "DSC_0433.jpg",
  "DSC_0440 2.jpg", "DSC_0442.jpg", "DSC_0446 2.jpg", "DSC_0449.jpg", "DSC_0461 2.jpg",
  "DSC_0462.jpg", "DSC_0466.jpg", "DSC_0467.jpg", "DSC_0469.jpg", "DSC_0471.jpg",
  "DSC_0476.jpg", "DSC_0479.jpg", "DSC_0481.jpg", "DSC_0482.jpg", "DSC_0483.jpg",
  "DSC_0485.jpg", "DSC_0493.jpg",
];

const ofunaGallery = ofunaGalleryFiles.map((file, i) => {
  const encoded = encodeURIComponent(file);
  const thumb = `/images/ofuna/gallery/thumb/${encoded}`;
  return {
    full: thumb,
    thumb,
    alt: `大船店のスペースの様子 ${i + 1}`,
  };
});

const ofunaReviews = [
  "/images/figma/review-yokohama-1.png",
  "/images/figma/review-ofuna-2.png",
  "/images/figma/review-ofuna-3.png",
  "/images/figma/review-ofuna-4.png",
];

const steps = [
  { label: "STEP 01", en: "RESERVE", jp: "WEB予約", desc: "お好きな日時を選んで\n24時間いつでも予約可能" },
  { label: "STEP 02", en: "ENTER", jp: "入室", desc: "予約確定後に入室方法や\n機材の利用方法をお送りします" },
  { label: "STEP 03", en: "ENJOY", jp: "自由に過ごす", desc: "映画・ゲームなど\n自由にお楽しみください" },
  { label: "STEP 04", en: "CLEANING", jp: "清掃後退出", desc: "簡単なセルフクリーニングをして\n退出をお願いします" },
];

const reviewSummaryImages = [
  "/images/figma/review-summary-1.png",
  "/images/figma/review-summary-2.png",
  "/images/figma/review-summary-3.png",
  "/images/figma/review-ofuna-4.png",
  "/images/figma/review-summary-5.png",
  "/images/figma/review-summary-6.png",
];

const faqs = [
  { q: "ゴミは捨てられますか？", a: "基本的にはお持ち帰りをお願いしていますが、有料のゴミ回収オプション（¥550）もご用意しています。" },
  { q: "商用利用・撮影は可能ですか？", a: "商用撮影オプション（¥1,650）にご加入いただければ可能です。事前にLINEでご相談ください。" },
  { q: "駐輪場はありますか？", a: "店舗専用の駐輪場はございません。近隣のコインパーキング・駐輪場をご利用ください。" },
];
---

<BaseLayout
  title="Smart ホームシアター｜友達と過ごす特別な時間を。大画面シアター貸切スペース（横浜中華街・大船）"
  description="友達とのパーティー、推し活、映画鑑賞に。100インチ大画面と本格音響の貸切ホームシアター。横浜中華街店・大船店の2拠点、スペースマーケットから空き状況確認・予約できます。"
  canonical="https://example.com/"
  ogTitle="Smart ホームシアター｜友達と過ごす特別な時間を。"
  ogDescription="横浜中華街・大船の2拠点。映画も、推し活も、パーティーも。大画面×本格音響の貸切シアター。"
  ogImage="https://example.com/images/brand/og.jpg"
  navLinks={navLinks}
  jsonLd={jsonLd}
>
  <!-- SECTION 1: HERO -->
  <section class="hero" style={`--hero-image: ${heroBg};`}>
    <div class="hero-follow">
      <span>FOLLOW US</span>
      <div class="divider"></div>
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label="Instagramをフォロー">
        <img src="/images/figma/icon-instagram.png" alt="" width="18" height="18" />
      </a>
    </div>
    <div class="container">
      <div class="hero-wordmark">
        <p class="smart">Smart</p>
        <h1>HOMETHEATER</h1>
        <p class="hero-subtitle">
          大画面×高音質のプライベートシアター<br />
          映画鑑賞も、推し活も、パーティーも、周りを気にせず楽しめます
        </p>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true">SCROLL</div>
  </section>

  <!-- SECTION 2: 映画をきっかけに -->
  <section id="scenes">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Purpose</span>
        <h2>映画をきっかけに<br />気づけば夜まで盛り上がる</h2>
        <p class="mt-md" style="max-width: 640px; margin-left: auto; margin-right: auto;">
          映画館のような設備と、リビングのようなくつろぎ<br />
          時間を忘れて楽しめるSmartホームシアターへ<br /><br />
          映画やライブ配信を楽しんだあとは、<br />
          そのままゲームをしたり、ごはんを食べたり、写真を撮ったり<br />
          気づけば「また来たいね」と話している。<br />
          そんなホームシアター空間です。
        </p>
      </div>

      <div class="persona-grid">
        <div class="persona-col">
          {personaCards.slice(0, 2).map((card) => (
            <div class="persona-card" style={`background-image: url('${card.image}');`}>
              <p class="jp">{card.jp}</p>
              <p class="en">{card.en}</p>
            </div>
          ))}
        </div>
        <div class="persona-col offset">
          {personaCards.slice(2, 4).map((card) => (
            <div class="persona-card" style={`background-image: url('${card.image}');`}>
              <p class="jp">{card.jp}</p>
              <p class="en">{card.en}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: あなたはどっち？ -->
  <section id="spaces" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">location</span>
        <h2>あなたはどっち？</h2>
      </div>

      <div class="location-compare">
        <article class="location-card" data-location="yokohama">
          <div class="card-image" style={`background-image: ${motomachiBg};`} role="img" aria-label="横浜中華街店のイメージ"></div>
          <div class="name-stack">
            <p class="watermark">YOKOHAMA</p>
            <p class="card-title">横浜中華街店</p>
          </div>
          <div class="card-body">
            <p class="card-copy">元町・中華街エリアでふらっと立ち寄れる</p>
            <div class="capacity-row">
              <span class="badge">定員人数</span>
              <span>6人収容・6人着席可能 / 25㎡</span>
            </div>
            <div class="card-access"><img src="/images/figma/icon-train.png" alt="" class="icon-train" />JR根岸線 石川町駅 徒歩4分</div>
            <a href="#yokohama" class="arrow-btn" aria-label="横浜中華街店の詳細を見る"></a>
          </div>
        </article>

        <article class="location-card" data-location="ofuna">
          <div class="card-image" style={`background-image: ${ofunaBg};`} role="img" aria-label="大船店のイメージ"></div>
          <div class="name-stack">
            <p class="watermark">SHONAN</p>
            <p class="card-title">大船</p>
          </div>
          <div class="card-body">
            <p class="card-copy">大船駅すぐ。大人数の集まりにも。</p>
            <div class="capacity-row">
              <span class="badge">定員人数</span>
              <span>10人収容・8人着席可能 / 33.2㎡</span>
            </div>
            <div class="card-access"><img src="/images/figma/icon-train.png" alt="" class="icon-train" />湘南モノレール 大船駅 徒歩4分</div>
            <a href="#ofuna" class="arrow-btn" aria-label="大船の詳細を見る"></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- SECTION 4A: 横浜中華街店 詳細 -->
  <section id="yokohama" class="detail-section" data-location="yokohama">
    <div class="glow top" aria-hidden="true"></div>
    <div class="glow bottom" aria-hidden="true"></div>
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">YOKOHAMA</span>
        <h2>横浜中華街店</h2>
      </div>

      <div class="detail-hero" style={`background-image: ${yokohamaHeroImg};`} role="img" aria-label="横浜中華街店の室内（差し替え予定）">
        <div class="detail-hero-stat">
          <div class="capacity-row">
            <span class="badge">定員人数</span>
            <span>6人収容・6人着席可能 / 25㎡</span>
          </div>
          <div class="access-row"><img src="/images/figma/icon-train.png" alt="" class="icon-train" />JR根岸線 石川町駅 徒歩4分</div>
        </div>
      </div>

      <p class="detail-intro">
        石川町駅から徒歩4分、元町・中華街駅からも徒歩7分。中華街での食べ歩きのあとに、ふかふかのソファがある貸切シアターへ。大画面のスクリーンと、迫力ある音響。映画も、推し活も、ゲームも、気づけば時間を忘れてしまう、そんなひとときを。
      </p>

      <div class="equipment-row">
        {yokohamaEquipment.map((item) => (
          <div class="equipment-item">
            <p class="label">{item.label}</p>
            <p class="brand">{item.brand}</p>
            <img src={item.img} alt={item.brand} loading="lazy" />
          </div>
        ))}
      </div>

      <div class="gallery mt-lg">
        {yokohamaGallery.map((item) => (
          <div
            class="gallery-item"
            data-gallery-item
            data-full={item.full}
            style={`background-image: url('${item.thumb}');`}
            aria-label={item.alt}
          ></div>
        ))}
      </div>

      <div class="review-image-grid">
        {yokohamaReviews.map((src, i) => (
          <div class="review-image-card">
            <img src={src} alt={`横浜中華街店の口コミ ${i + 1}`} loading="lazy" />
          </div>
        ))}
      </div>
      <p class="review-note">※レビューはスペースマーケットに投稿された、2026年8月時点のものです。</p>

      <div class="text-center">
        <a href={SPACEMARKET_YOKOHAMA} target="_blank" rel="noopener noreferrer" class="availability-btn">
          <span class="icon-badge">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="4" width="18" height="17" rx="2" />
              <path d="M3 9h18M8 2v4M16 2v4" />
            </svg>
          </span>
          <span class="label"><small>横浜中華街店の</small><strong>空き状況を確認する</strong></span>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 4B: 大船店 詳細 -->
  <section id="ofuna" class="detail-section" data-location="ofuna" style="background: var(--bg-secondary);">
    <div class="glow top" aria-hidden="true"></div>
    <div class="glow bottom" aria-hidden="true"></div>
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">OFUNA</span>
        <h2>大船</h2>
      </div>

      <div class="detail-hero" style={`background-image: ${ofunaHeroImg};`} role="img" aria-label="大船店の室内">
        <div class="detail-hero-stat">
          <div class="capacity-row">
            <span class="badge">定員人数</span>
            <span>10人収容・8人着席可能 / 33.2㎡</span>
          </div>
          <div class="access-row"><img src="/images/figma/icon-train.png" alt="" class="icon-train" />湘南モノレール 大船駅 徒歩4分</div>
        </div>
      </div>

      <p class="detail-intro">
        大船駅から徒歩4分。最大10名まで入れる広めの空間で、パーティーや女子会にもぴったりです。飲食・アルコール持込OK。キッチン設備もあり、ホームパーティの延長として使えます。
      </p>

      <div class="equipment-row">
        {ofunaEquipment.map((item) => (
          <div class="equipment-item">
            <p class="label">{item.label}</p>
            <p class="brand">{item.brand}</p>
            <img src={item.img} alt={item.brand} loading="lazy" />
          </div>
        ))}
      </div>

      <div class="gallery mt-lg">
        {ofunaGallery.slice(0, 5).map((item, i) => (
          <div
            class:list={["gallery-item", i >= 4 && "is-hidden"]}
            data-gallery-item
            data-full={item.full}
            style={`background-image: url('${item.thumb}');`}
            aria-label={item.alt}
          >
            {i === 3 && (
              <span class="gallery-more" aria-hidden="true">
                +{ofunaGallery.length - 4}
                <small>枚</small>
              </span>
            )}
          </div>
        ))}
      </div>

      <div class="review-image-grid">
        {ofunaReviews.map((src, i) => (
          <div class="review-image-card">
            <img src={src} alt={`大船店の口コミ ${i + 1}`} loading="lazy" />
          </div>
        ))}
      </div>
      <p class="review-note">※レビューはスペースマーケットに投稿された、2026年8月時点のものです。</p>

      <div class="text-center">
        <a href={SPACEMARKET_OFUNA} target="_blank" rel="noopener noreferrer" class="availability-btn">
          <span class="icon-badge">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="4" width="18" height="17" rx="2" />
              <path d="M3 9h18M8 2v4M16 2v4" />
            </svg>
          </span>
          <span class="label"><small>大船の</small><strong>空き状況を確認する</strong></span>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 5: FIRE TV -->
  <section id="firetv">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">FIRE TV</span>
        <h2>映画もドラマもアニメも<br />大画面で見放題</h2>
      </div>

      <div class="firetv-content">
        <img src="/images/figma/firetv-logos.png" alt="対応する動画配信サービス（Netflix・U-NEXT・TVer・Hulu・Prime Videoなど）" loading="lazy" />
        <img src="/images/figma/firetv-stick.png" alt="Fire TV Stick" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- SECTION 6: STEPS -->
  <section id="flow" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">STEPS</span>
        <h2>はじめての方も安心して<br />ご利用いただけます</h2>
      </div>

      <div class="steps-flow">
        {steps.map((step, i) => (
          <>
            <div class="step">
              <p class="step-label">{step.label}</p>
              <p class="step-en">{step.en}</p>
              <p class="step-jp">{step.jp}</p>
              <p class="step-desc">{step.desc.split("\n").map((line) => <>{line}<br /></>)}</p>
            </div>
            {i < steps.length - 1 && <span class="arrow" aria-hidden="true">→</span>}
          </>
        ))}
      </div>

      <p class="rule-list">
        喫煙・騒音・迷惑行為は禁止です。<br />
        キャンセル料は予約成立後から発生するため、日程変更は利用2日前12時までにご連絡ください。
      </p>
    </div>
  </section>

  <!-- SECTION 7: REVIEWS -->
  <section id="voices">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">REVIEWS</span>
        <h2>お客様の声</h2>
      </div>

      <div class="review-scores">
        <div class="review-score">
          <p class="store">横浜中華街店 <span class="count">196件</span></p>
          <p class="score"><span class="star">★</span>4.7</p>
        </div>
        <div class="review-score">
          <p class="store">大船店 <span class="count">50件</span></p>
          <p class="score"><span class="star">★</span>4.8</p>
        </div>
      </div>

      <div class="review-image-grid" style="grid-template-columns: repeat(3, 1fr);">
        {reviewSummaryImages.map((src, i) => (
          <div class="review-image-card">
            <img src={src} alt={`お客様の声 ${i + 1}`} loading="lazy" />
          </div>
        ))}
      </div>
      <p class="review-note">※レビューはスペースマーケットに投稿された、2026年8月時点のものです。</p>
    </div>
  </section>

  <!-- SECTION 8: FAQ -->
  <section id="faq" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">FAQ</span>
        <h2>よくある質問</h2>
      </div>

      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary><span class="q-mark">Q.</span><span class="q-text">{item.q}</span></summary>
            <div class="answer">
              <span class="a-mark">A.</span>
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 9: ACCESS -->
